{
  "id": "YtmReviewAlrt003",
  "name": "YT AI Manager · 03 Review alerts",
  "nodes": [
    {
      "parameters": {
        "content": "## Review alerts\nPings your Discord / Slack / Teams webhook when new ideas, scripts or finished videos are waiting for approval (each item is announced once per stage). Set **notifyWebhook** in the Config node.",
        "height": 220,
        "width": 420
      },
      "id": "185eeb74-4fd4-448c-b834-8391c9eec0cd",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "eed8e9bb-6de6-4610-8613-fd2ad8e2e9b5",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"baseUrl\": \"http://127.0.0.1:8765\",\n  \"apiKey\": \"PASTE_YTM_API_KEY\",\n  \"notifyWebhook\": \"\"\n}",
        "options": {}
      },
      "id": "469a7f7e-b48d-44f8-8428-8fc406862a9f",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "Edit once: API base URL, YTM_API_KEY (injected by install.ps1) and an optional Discord/Slack/Teams webhook for alerts."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.baseUrl }}/api/reviews/pending?mark=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').item.json.apiKey }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "15cd6033-0db9-4e4c-a15d-00ff527cea27",
      "name": "Get new review items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "ad35413c-764c-4d34-a35e-4468bbcc35b5",
              "leftValue": "={{ $json.count }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            },
            {
              "id": "73b7a046-9f70-4c03-82bf-8474bd37e36b",
              "leftValue": "={{ $('Config').item.json.notifyWebhook }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0ab2c9c5-f11d-425c-a6ec-676d57574e81",
      "name": "Anything new + webhook set?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.notifyWebhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $('Get new review items').item.json.text, text: $('Get new review items').item.json.text }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "bebe8380-e277-4303-a487-6b488a08c152",
      "name": "Send alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -20
      ],
      "notes": "Discord uses 'content', Slack/Teams-workflow webhooks use 'text' - both are sent."
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Get new review items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get new review items": {
      "main": [
        [
          {
            "node": "Anything new + webhook set?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything new + webhook set?": {
      "main": [
        [
          {
            "node": "Send alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "tags": []
}