{
  "id": "YtmResearch00001",
  "name": "YT AI Manager · 01 Daily research",
  "nodes": [
    {
      "parameters": {
        "content": "## Daily research\nQueues one research job per active channel. The local LLM turns trends, feeds and competitor uploads into ranked ideas, which land in the dashboard's **Review** tab. Workflow 03 alerts you when they are ready.",
        "height": 220,
        "width": 420
      },
      "id": "bb10bb87-0f5d-42e6-83bb-8737fcf5416b",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "52044e65-f193-4af9-843c-cf4375b848cb",
      "name": "Every day 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"baseUrl\": \"http://127.0.0.1:8765\",\n  \"apiKey\": \"PASTE_YTM_API_KEY\",\n  \"notifyWebhook\": \"\"\n}",
        "options": {}
      },
      "id": "a15a3763-fbfd-4f6a-a3dc-c7328aaea1df",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "Edit once: API base URL, YTM_API_KEY (injected by install.ps1) and an optional Discord/Slack/Teams webhook for alerts."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.baseUrl }}/api/research/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').item.json.apiKey }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"channel\": null}"
      },
      "id": "0f878c5a-dbbd-4e4b-a821-d0a10203baaa",
      "name": "Queue research (all channels)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every day 06:00": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Queue research (all channels)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "tags": []
