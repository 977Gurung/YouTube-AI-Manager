#!/usr/bin/env python3
# Sandbox stand-in for nvidia-smi: an RTX 2070 Max-Q whose load rises and falls like a render job.
import math, sys, time
t = time.time()
if any("query-compute-apps" in a for a in sys.argv):
    print("2100, /home/user/yt-ai-manager/.venv/bin/python, %d" % (3900 + 900 * math.sin(t / 23)))
    print("1422, /usr/local/bin/ollama, 512")
else:
    busy = 0.5 + 0.5 * math.sin(t / 9)
    util = max(0, min(100, 55 + 42 * math.sin(t / 5) * busy + 8 * math.sin(t * 1.7)))
    print("NVIDIA GeForce RTX 2070 with Max-Q Design, %d, %d, 8192, %d, %.1f, %d, [N/A]" %
          (util, 4400 + 1300 * math.sin(t / 23), 61 + 14 * busy, 38 + 52 * util / 100, util * 0.6))
