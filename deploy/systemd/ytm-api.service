[Unit]
Description=YouTube AI Manager - API, dashboard and GPU worker
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/run-api.sh
Restart=on-failure
RestartSec=10
# rendering and Whisper shouldn't make the box unresponsive over SSH
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# ffmpeg/whisper children are stopped with the service
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
