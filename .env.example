# Copy to .env (install.sh does this and generates YTM_API_KEY for you).

# Protects the API + dashboard. n8n sends it as the X-API-Key header.
YTM_API_KEY=

# Google Cloud: YouTube Data API v3 key (research + analytics; public data only)
YOUTUBE_API_KEY=
# OAuth Desktop client JSON downloaded from Google Cloud (uploads)
GOOGLE_CLIENT_SECRETS=./secrets/client_secret.json

# Stock footage (free keys): https://www.pexels.com/api/  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional paid voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
